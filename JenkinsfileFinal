pipeline {
    agent any

    parameters {
        choice(
            name: 'NAMESPACE',
            choices: ['salma-env', 'majda-env'],
            description: 'Namespace cible du déploiement Kubernetes'
        )
    }

    tools {
        maven 'M2_HOME'
        jdk 'JDK21'
    }

    stages {
        stage('1. Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('2. Build & Tests (Maven + JUnit)') {
            steps {
                sh 'mvn clean verify'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('3. SonarQube Analysis') {
            steps {
                withSonarQubeEnv('MySonarQubeServer') {
                    sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.host.url=$SONAR_HOST_URL -Dsonar.token=$SONAR_AUTH_TOKEN'
                }
            }
        }

        stage('4. Continuous Delivery (Ansible: Docker Hub & Kubernetes)') {
            steps {
                script {
                    sh '''
                        if ! command -v kubectl &> /dev/null; then
                            curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
                            chmod +x kubectl
                            mkdir -p bin
                            mv kubectl bin/
                        fi
                    '''

                    withEnv(["PATH+TOOLS=${WORKSPACE}/bin:/usr/local/bin:/usr/bin:/bin:/mnt/c/Program Files/Docker/Docker/resources/bin"]) {
                        kubeconfig(credentialsId: 'kubeconfig-file', serverUrl: '') {
                            withCredentials([string(credentialsId: 'ansible_vault_pass', variable: 'VAULT_PASS')]) {
                                sh """
                                    set -e
                                    trap 'rm -f vault_pass.txt' EXIT
                                    echo "\$VAULT_PASS" > vault_pass.txt
                                    ansible-playbook -i localhost, -c local playbookCICD.yml \
                                        --vault-password-file vault_pass.txt \
                                        -e "target_namespace=${params.NAMESPACE} image_tag=${params.NAMESPACE}-${BUILD_NUMBER}"
                                """
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "Pipeline CI/CD terminé avec succès ! Micro-service déployé (3 pods) dans ${params.NAMESPACE}."
        }
        failure {
            echo "Échec du pipeline CI/CD. Vérifie les logs de l'étape en erreur."
        }
    }
}
